# Local secrets and settings. Created by scripts/install.sh.
config/config.php
# Web settings saves: permanent lock file and transient secret temp files.
config/config.php.lock
config/.config-*.php
# Accidental local pairing, environment and build output. Keep them outside source.
/example-client.json
/.env
/build/
/out/
# User-installed plugins. They live next to config.php so Core updates keep them
# (unknown files + private config) and so Apache already denies the folder.
/config/plugins/
